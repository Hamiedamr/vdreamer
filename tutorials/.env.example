# Copy to .env (git-ignored) in this folder. Every vdreamer command reads it.
# The token is any secret of 16+ characters; clients send it as a bearer token.
VDREAMER_INTERNAL_TOKEN=tutorial-token-change-me-0123456789
# Only if config/models.vllm.yaml points at a server that needs a key:
# LLM_API_KEY=...
